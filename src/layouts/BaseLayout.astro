---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "../styles/tailwind.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  activePath?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  wordCount?: number;
  keywords?: string;
}

const {
    title,
    description,
    type = "website",
    activePath = "/",
    publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  wordCount,
  keywords,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="font-sans antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14120f" media="(prefers-color-scheme: dark)" />
    <script is:inline>const getThemePreference = () => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") return saved;
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      };
      const isDark = getThemePreference() === "dark";
      document.documentElement.classList[isDark ? "add" : "remove"]("dark");
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" sizes="96x96" type="image/png" />
    <link rel="shortcut icon" href="/favicon-96x96.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <SeoHead
      title={title}
      description={description}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      noindex={noindex}
      wordCount={wordCount}
      keywords={keywords}
    />
    <ClientRouter />
  </head>
  <body
    id="top"
    class="min-h-screen bg-[#faf9f5] text-stone-900 transition-colors duration-200 dark:bg-[#14120f] dark:text-stone-100"
  >
    <SiteHeader activePath={activePath} />
    <main>
      <slot />
    </main>
    <SiteFooter />

    <!-- Scroll reveal observer — works with Astro view transitions -->
    <script>const setupReveal = () => {
        const els = document.querySelectorAll(".reveal, .stagger");
        if (!("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -60px 0px" },
        );
        els.forEach((el) => io.observe(el));
      };
      setupReveal();
      document.addEventListener("astro:after-swap", setupReveal);
    </script>

    <!-- UI sound feedback — synthesized blips, no audio files.
         Plays on elements with [data-sound], mute persisted in localStorage. -->
    <script>let audioCtx: AudioContext | null = null;
      const getCtx = () => {
        audioCtx ??= new AudioContext();
        return audioCtx;
      };
      type SoundName = "blip" | "pop" | "chime";
      const sounds: Record<SoundName, () => void> = {
        blip: () => {
          const ctx = getCtx();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = "sine";
          osc.frequency.setValueAtTime(520, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(760, ctx.currentTime + 0.07);
          gain.gain.setValueAtTime(0.05, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.1);
          osc.connect(gain).connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.1);
        },
        pop: () => {
          const ctx = getCtx();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = "triangle";
          osc.frequency.setValueAtTime(300, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(620, ctx.currentTime + 0.09);
          gain.gain.setValueAtTime(0.06, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.12);
          osc.connect(gain).connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.12);
        },
        chime: () => {
          const ctx = getCtx();
          [660, 880].forEach((freq, i) => {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = "triangle";
            osc.frequency.value = freq;
            const start = ctx.currentTime + i * 0.08;
            gain.gain.setValueAtTime(0.045, start);
            gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.18);
            osc.connect(gain).connect(ctx.destination);
            osc.start(start);
            osc.stop(start + 0.18);
          });
        },
      };
      document.addEventListener("click", (e) => {
        if (localStorage.getItem("sounds") === "off") return;
        const target = e.target as Element | null;
        const el = target?.closest?.("[data-sound], .btn-primary, .btn-secondary");
        if (!el) return;
        try {
          const name = (el as HTMLElement).dataset.sound as SoundName | undefined;
          sounds[name ?? "blip"]?.();
        } catch {
          /* audio unavailable — stay silent */
        }
      });
    </script>
  </body>
</html>
