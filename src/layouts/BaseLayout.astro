---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { ModeWatcher } from "mode-watcher";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";

interface Props {
    title: string;
    description: string;
    type?: "website" | "article";
    activePath?: string;
    publishedTime?: Date;
    modifiedTime?: Date;
    tags?: string[];
    noindex?: boolean;
    wordCount?: number;
    keywords?: string;
}

const {
    title,
    description,
    type = "website",
    activePath = "/",
    publishedTime,
    modifiedTime,
    tags = [],
    noindex = false,
    wordCount,
    keywords,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="font-sans antialiased">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="theme-color"
            content="#faf9f5"
            media="(prefers-color-scheme: light)"
        />
        <meta
            name="theme-color"
            content="#14120f"
            media="(prefers-color-scheme: dark)"
        />
        <script is:inline>
            const isBrowser = typeof localStorage !== "undefined";
            const getThemePreference = () => {
                if (isBrowser && localStorage.getItem("theme")) {
                    return localStorage.getItem("theme");
                }
                return window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light";
            };
            const isDark = getThemePreference() === "dark";
            document.documentElement.classList[isDark ? "add" : "remove"](
                "dark",
            );
            if (isBrowser) {
                const observer = new MutationObserver(() => {
                    const isDark =
                        document.documentElement.classList.contains("dark");
                    localStorage.setItem("theme", isDark ? "dark" : "light");
                });
                observer.observe(document.documentElement, {
                    attributes: true,
                    attributeFilter: ["class"],
                });
            }
        </script>
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link
            rel="icon"
            href="/favicon-96x96.png"
            sizes="96x96"
            type="image/png"
        />
        <link rel="shortcut icon" href="/favicon-96x96.png" type="image/png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <SeoHead
            title={title}
            description={description}
            type={type}
            publishedTime={publishedTime}
            modifiedTime={modifiedTime}
            tags={tags}
            noindex={noindex}
            wordCount={wordCount}
            keywords={keywords}
        />
        <ClientRouter />
    </head>
    <body
        id="top"
        class="min-h-screen bg-[#faf9f5] text-stone-900 transition-colors duration-200 dark:bg-[#14120f] dark:text-stone-100"
    >
        <a
            href="#main"
            class="btn-primary sr-only fixed top-4 left-4 z-999 focus:not-sr-only focus:z-999"
        >
            Skip to content
        </a>
        <SiteHeader activePath={activePath} />
        <main id="main">
            <slot />
        </main>
        <SiteFooter />
        <ModeWatcher client:load />

        <script>
            import "../scripts/reveal";
            import { initSounds } from "../scripts/sounds";

            initSounds();
        </script>
    </body>
</html>
