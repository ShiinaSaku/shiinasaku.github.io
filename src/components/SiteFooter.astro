---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";

const year = new Date().getFullYear();

const pages = [
    { label: "Writing", href: "/blog/" },
    { label: "Friends", href: "/friends/" },
    { label: "RSS", href: "/rss.xml" },
];

const elsewhere = [
    { label: "GitHub", href: "https://github.com/shiinasaku", icon: "i-simple-icons-github" },
    { label: "X", href: "https://x.com/saku_shiina", icon: "i-simple-icons-x" },
    { label: "Email", href: "mailto:sakushiina@proton.me", icon: "i-lucide-mail" },
];
---

<footer class="mt-24 border-t hairline">
    <div class="container-page">
        <div class="flex flex-col gap-10 py-12 sm:flex-row sm:items-start sm:justify-between">
            <div class="max-w-xs">
                <div class="flex items-center gap-3">
                    <Image
                        src={avatar}
                        alt="Saku Shiina"
                        width={80}
                        height={80}
                        quality={90}
                        class="size-10 rounded-full object-cover ring-2 ring-accent-500/50"
                        loading="lazy"
                        decoding="async"
                    />
                    <div>
                        <p class="font-display text-base font-bold text-stone-900 dark:text-stone-100">
                            Saku Shiina
                        </p>
                        <p class="jp-accent" lang="ja">椎名 朔</p>
                    </div>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-stone-500 dark:text-stone-500">
                    Full-stack engineer building software that feels calm.
                </p>
            </div>

            <div class="flex gap-14">
                <nav class="flex flex-col gap-2.5" aria-label="Pages">
                    <p class="kicker">Pages</p>
                    {pages.map((link) => (
                        <a
                            href={link.href}
                            class="text-sm font-bold text-stone-500 transition-colors hover:text-accent-600 dark:text-stone-400 dark:hover:text-accent-400"
                        >
                            {link.label}
                        </a>
                    ))}
                </nav>
                <nav class="flex flex-col gap-2.5" aria-label="Elsewhere">
                    <p class="kicker">Elsewhere</p>
                    {elsewhere.map((link) => (
                        <a
                            href={link.href}
                            class="inline-flex items-center gap-2 text-sm font-bold text-stone-500 transition-colors hover:text-accent-600 dark:text-stone-400 dark:hover:text-accent-400"
                            {...(link.href.startsWith("http") ? { target: "_blank", rel: "noreferrer noopener" } : {})}
                        >
                            <span class={`${link.icon} size-3.5`} aria-hidden="true"></span>
                            {link.label}
                        </a>
                    ))}
                </nav>
            </div>
        </div>

        <div class="flex flex-col gap-2 border-t hairline py-6 sm:flex-row sm:items-center sm:justify-between">
            <p class="font-display text-sm font-bold text-stone-800 dark:text-stone-200">
                © {year} Saku Shiina
            </p>
            <p class="text-xs font-bold text-stone-500 dark:text-stone-400">
                shiina.xyz
            </p>
        </div>
    </div>
</footer>
