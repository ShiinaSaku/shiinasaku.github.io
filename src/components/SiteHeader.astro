---
import { Image } from "astro:assets";
import ModeToggle from "./ModeToggle.vue";
import SoundToggle from "./SoundToggle.vue";
import avatar from "../assets/avatar.png";

interface Props {
    activePath?: string;
}

const { activePath = "/" } = Astro.props;

const menuItems = [
    { label: "Writing", href: "/blog/" },
    { label: "Friends", href: "/friends/" },
];
---

<header class="sticky top-0 z-50 border-b hairline bg-[#faf9f5]/85 backdrop-blur-md dark:bg-[#14120f]/85">
    <div class="container-page flex h-16 items-center justify-between">
        <a
            href="/"
            class="group flex items-center gap-2.5"
            aria-label="Home"
        >
            <Image
                src={avatar}
                alt="Saku Shiina avatar"
                width={64}
                height={64}
                quality={90}
                class="size-8 rounded-full object-cover ring-2 ring-accent-500/60 transition-transform duration-300 group-hover:rotate-6"
                loading="eager"
                decoding="async"
            />
            <span class="font-display text-base font-bold tracking-tight text-stone-900 dark:text-stone-100">
                Saku Shiina
            </span>
            <span class="jp-accent hidden sm:inline" lang="ja">椎名 朔</span>
        </a>

        <nav class="flex items-center gap-1" aria-label="Main">
            {menuItems.map((item) => (
                <a
                    href={item.href}
                    aria-current={activePath === item.href ? "page" : undefined}
                    class:list={[
                        "rounded-lg px-3.5 py-2 text-sm font-bold transition-colors",
                        activePath === item.href
                            ? "bg-accent-500/10 text-accent-600 dark:text-accent-400"
                            : "text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100",
                    ]}
                >
                    {item.label}
                </a>
            ))}
            <SoundToggle client:only="vue" />
            <ModeToggle client:only="vue" />
        </nav>
    </div>
</header>
