---
import { getImagePath } from "astro-takumi/dist/util.js";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  canonicalPath?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  wordCount?: number;
  keywords?: string;
}

const {
  title,
  description,
  type = "website",
  canonicalPath,
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  wordCount,
  keywords,
} = Astro.props;

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "https://shiina.xyz";
const path = canonicalPath ?? Astro.url.pathname;
const cleanPath = path.endsWith("/") || path.split("/").pop()?.includes(".") ? path : `${path}/`;
const canonical = new URL(cleanPath, siteOrigin).toString();
const fullTitle = title.includes("Saku Shiina") ? title : `${title} | Saku Shiina`;
const siteName = "Saku Shiina";
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";
const articlePublished = publishedTime?.toISOString();
const articleModified = (modifiedTime ?? publishedTime)?.toISOString();
const breadcrumbParts = path.split("/").filter(Boolean);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteOrigin}/#person`,
  name: siteName,
  alternateName: ["椎名 朔", "椎名朔", "さくしいな", "シイナサク", "Shiina Saku"],
  givenName: "Saku",
  familyName: "Shiina",
  url: siteOrigin,
  image: `${siteOrigin}/avatar-512.png`,
  sameAs: [
    "https://github.com/shiinasaku",
    "https://x.com/saku_shiina",
  ],
  jobTitle: "Full-Stack Engineer",
  knowsLanguage: ["en", "ja"],
  knowsAbout: ["Astro", "Rust", "Go", "Bun", "TypeScript", "UnoCSS", "Vue", "React", "Next.js", "Nuxt.js"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteOrigin}/#website`,
  name: siteName,
  alternateName: "椎名 朔",
  url: siteOrigin,
  inLanguage: ["en", "ja"],
  publisher: { "@id": `${siteOrigin}/#person` },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteOrigin}/#organization`,
  name: siteName,
  url: siteOrigin,
  logo: {
    "@type": "ImageObject",
    url: `${siteOrigin}/avatar-512.png`,
    width: 512,
    height: 512,
  },
  founder: { "@id": `${siteOrigin}/#person` },
  sameAs: [
    "https://github.com/shiinasaku",
    "https://x.com/saku_shiina",
  ],
};

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${siteOrigin}/blog/#blog`,
  url: `${siteOrigin}/blog/`,
  name: "Saku Shiina Blog",
  description: "Engineering essays on architecture, performance, and product systems.",
  author: { "@id": `${siteOrigin}/#person` },
};

const articleSchema =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        description,
        datePublished: articlePublished,
        dateModified: articleModified,
        mainEntityOfPage: canonical,
        inLanguage: "en",
        author: { "@id": `${siteOrigin}/#person` },
        keywords: tags.join(", "),
        ...(wordCount && { wordCount }),
      }
    : null;

const breadcrumbSchema =
  breadcrumbParts.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbParts.map((part, index) => {
          const itemPath = `/${breadcrumbParts.slice(0, index + 1).join("/")}/`;
          const name = part
            .replace(/[-_]/g, " ")
            .split(" ")
            .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
            .join(" ");
          return {
            "@type": "ListItem",
            position: index + 1,
            name,
            item: new URL(itemPath, siteOrigin).toString(),
          };
        }),
      }
    : null;

const jsonLd = (data: object) => JSON.stringify(data).replace(/</g, "\\u003c");

const ogImage = getImagePath({ url: Astro.url, site: Astro.site, format: "webp" });
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content={siteName} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
<meta property="og:locale" content="en_US" />
<meta property="og:locale:alternate" content="ja_JP" />
<meta name="generator" content={Astro.generator} />
<link rel="alternate" type="application/rss+xml" title={`${siteName} Blog RSS`} href="/rss.xml" />
<link rel="me" href="https://github.com/shiinasaku" />
<link rel="me" href="https://x.com/saku_shiina" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@saku_shiina" />
<meta name="twitter:creator" content="@saku_shiina" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteName} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{type === "article" && articlePublished && <meta property="article:published_time" content={articlePublished} />}
{type === "article" && articleModified && <meta property="article:modified_time" content={articleModified} />}
{type === "article" && <meta property="article:author" content={`${siteOrigin}/#person`} />}
{
  type === "article" &&
    tags.map((tag) => <meta property="article:tag" content={tag} />)
}

<script is:inline type="application/ld+json" set:html={jsonLd(person)} />
<script is:inline type="application/ld+json" set:html={jsonLd(websiteSchema)} />
<script is:inline type="application/ld+json" set:html={jsonLd(organizationSchema)} />
<script is:inline type="application/ld+json" set:html={jsonLd(blogSchema)} />
{articleSchema && <script is:inline type="application/ld+json" set:html={jsonLd(articleSchema)} />}
{breadcrumbSchema && <script is:inline type="application/ld+json" set:html={jsonLd(breadcrumbSchema)} />}
