---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { friends } from "../../lib/friends";
import type { FriendLinkType } from "../../data/friends";
import avatar from "../../assets/avatar.png";

const linkIcons: Record<FriendLinkType, string> = {
    website: "i-lucide-globe",
    blog: "i-lucide-pencil-line",
    github: "i-simple-icons-github",
    twitter: "i-simple-icons-x",
};

const linkColors: Record<FriendLinkType, string> = {
    website:
        "hover:border-sky-400/70 hover:text-sky-600 dark:hover:text-sky-400",
    blog: "hover:border-accent-400/70 hover:text-accent-600 dark:hover:text-accent-400",
    github: "hover:border-stone-500/70 hover:text-stone-900 dark:hover:text-stone-100",
    twitter:
        "hover:border-stone-500/70 hover:text-stone-900 dark:hover:text-stone-100",
};
---

<BaseLayout
    title="Friends — Saku Shiina"
    description="People I'm glad to know — from code, art, and everywhere in between. A small thank-you to good friends."
    activePath="/friends/"
>
    <section class="pt-20 pb-16 sm:pt-28">
        <div class="container-page">
            <div class="reveal max-w-2xl">
                <p class="kicker">Friends</p>
                <h1 class="title-display mt-5">
                    Good people, glad to know them.
                </h1>
                <p class="body-copy mt-5">
                    Friends come from everywhere — code, art, games, late-night
                    conversations. Writing code was never the entry requirement.
                    This page is a small thank-you.
                </p>
                <p class="jp-accent mt-3" lang="ja">大切な人たちの記録。</p>
            </div>

            <div class="stagger mt-14 flex flex-col gap-5">
                {
                    friends.map((friend) => (
                        <div class="group flex flex-col gap-5 rounded-xl border hairline bg-white p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent-400/50 hover:shadow-md sm:flex-row sm:items-center dark:bg-white/3 dark:hover:border-accent-400/40">
                            <img
                                src={friend.avatarUrl}
                                alt={`${friend.name} avatar`}
                                width={56}
                                height={56}
                                loading="lazy"
                                decoding="async"
                                class="size-14 shrink-0 rounded-full object-cover ring-2 ring-accent-500/30 transition-shadow duration-300 group-hover:ring-accent-500/60"
                            />
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                    <p class="font-display text-lg font-bold text-stone-900 dark:text-stone-100">
                                        {friend.name}
                                    </p>
                                    <span class="text-xs font-medium text-stone-400 dark:text-stone-600">
                                        {friend.location}
                                    </span>
                                </div>
                                <p class="mt-1.5 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                                    {friend.description}
                                </p>
                            </div>
                            <div class="flex shrink-0 items-center gap-2">
                                {friend.links.map((link) => (
                                    <a
                                        href={link.url}
                                        target="_blank"
                                        rel="noreferrer noopener"
                                        aria-label={`${friend.name} — ${link.type}`}
                                        title={link.type}
                                        class={`inline-flex size-9 items-center justify-center rounded-lg border hairline text-stone-400 transition-all duration-200 hover:-translate-y-0.5 dark:text-stone-500 ${linkColors[link.type]}`}
                                    >
                                        <span
                                            class={`${linkIcons[link.type]} size-4`}
                                            aria-hidden="true"
                                        />
                                    </a>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>

            <div
                class="reveal mt-14 flex items-center justify-between gap-6 rounded-xl border hairline bg-accent-500/3 p-6 sm:ml-auto sm:max-w-md dark:bg-accent-500/5"
            >
                <div class="flex items-center gap-4">
                    <Image
                        src={avatar}
                        alt="Saku Shiina"
                        width={96}
                        height={96}
                        quality={90}
                        class="size-12 shrink-0 rounded-full object-cover ring-2 ring-accent-500/50"
                        loading="lazy"
                        decoding="async"
                    />
                    <div>
                        <p
                            class="font-display text-base font-bold text-stone-900 dark:text-stone-100"
                        >
                            Know each other?
                        </p>
                        <p class="text-xs text-stone-500 dark:text-stone-500">
                            Say hi — I'd love to add you here.
                        </p>
                    </div>
                </div>
                <a
                    href="mailto:sakushiina@proton.me"
                    class="btn-primary shrink-0 px-4! py-2! text-xs"
                >
                    <span class="i-lucide-mail size-3.5" aria-hidden="true"
                    ></span>
                    Email
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
