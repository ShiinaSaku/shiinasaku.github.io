---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getReadingTimeMinutes } from "../../lib/readingTime";
import BlogFilter from "../../components/BlogFilter.vue";
import CountUp from "../../components/CountUp.vue";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const serializedPosts = posts.map((post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    date: post.data.date.toISOString(),
    tags: post.data.tags,
    readMinutes: getReadingTimeMinutes(post.body ?? ""),
}));
---

<BaseLayout
    title="Blog — Saku Shiina"
    description="Long-form essays on engineering strategy, frontend architecture, and search-first product execution."
    activePath="/blog/"
>
    <script is:inline>
        if (window.location.search.includes("tag=")) {
            const meta = document.createElement("meta");
            meta.name = "robots";
            meta.content = "noindex, follow";
            document.head.appendChild(meta);
        }
    </script>

    <!-- Header -->
    <section class="relative pt-28 pb-8 sm:pt-36">
        <div class="container-page">
            <div class="reveal max-w-3xl flex flex-col items-start gap-4">
                <span class="kicker">Essays</span>
                <h1 class="title-display">
                    Technical writing with execution detail.
                </h1>
                <p class="body-copy max-w-2xl">
                    Notes from building production web systems: architecture tradeoffs,
                    UX clarity, and performance outcomes that actually move web metrics.
                </p>
                <p class="jp-accent" lang="ja">実装・設計・改善の記録。</p>

                <!-- Post count stat -->
                <div class="mt-2 inline-flex items-center gap-3 rounded-2xl glass px-5 py-3">
                    <span class="font-display text-2xl font-bold text-rose-600 dark:text-rose-400"><CountUp client:visible end={posts.length} /></span>
                    <div class="flex flex-col text-left">
                        <span class="text-xs font-semibold uppercase tracking-wider text-zinc-600 dark:text-zinc-400">essays published</span>
                        <span class="text-[10px] font-medium text-zinc-400 dark:text-zinc-600" lang="ja">記事公開中</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- List -->
    <section class="relative pb-20 sm:pb-28">
        <div class="container-page">
            <div class="max-w-4xl mx-auto reveal">
                <BlogFilter client:load posts={serializedPosts} />
            </div>
        </div>
    </section>
</BaseLayout>
