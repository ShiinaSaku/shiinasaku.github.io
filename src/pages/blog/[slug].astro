---
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { getReadingTimeMinutes, getWordCount } from "../../lib/readingTime";
import ShareButton from "../../components/ShareButton.svelte";
import ScrollProgress from "../../components/ScrollProgress.svelte";
import avatarImage from "../../assets/avatar.png";

export const prerender = true;

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => !data.draft);
    return posts.map((post) => ({
        params: { slug: post.id },
    }));
}

const slug = Astro.params.slug;

if (!slug) {
    throw new Error("Missing blog slug parameter.");
}

const post = await getEntry("blog", slug);

if (!post || post.data.draft) {
    return Astro.redirect("/404");
}

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const currentIndex = allPosts.findIndex((p) => p.id === slug);
const olderPost =
    currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const body = post.body ?? "";
const readMinutes = getReadingTimeMinutes(body);
const wordCount = getWordCount(body);
---

<BaseLayout
    title={post.data.title}
    description={post.data.description}
    type="article"
    activePath="/blog/"
    publishedTime={post.data.date}
    modifiedTime={post.data.date}
    tags={post.data.tags}
    wordCount={wordCount}
>
    <ScrollProgress client:load />

    {
        tocHeadings.length > 1 && (
            <aside
                class="fixed top-36 right-6 z-40 hidden w-52 xl:block"
                aria-label="Table of contents"
            >
                <p class="mb-3 font-mono text-[10px] font-medium uppercase tracking-[0.18em] text-stone-400 dark:text-stone-600">
                    On this page
                </p>
                <nav class="flex flex-col gap-1 border-l hairline">
                    {tocHeadings.map((h) => (
                        <a
                            href={`#${h.slug}`}
                            data-toc-link={h.slug}
                            class:list={[
                                "-ml-px border-l-2 border-transparent py-1 pr-2 text-xs leading-snug text-stone-500 transition-colors duration-150 hover:text-stone-900 dark:text-stone-500 dark:hover:text-stone-100",
                                h.depth === 3 ? "pl-7" : "pl-4",
                            ]}
                        >
                            {h.text}
                        </a>
                    ))}
                </nav>
            </aside>
        )
    }

    <article class="pt-20 sm:pt-28">
        <div class="container-narrow">
            <!-- Breadcrumb -->
            <nav
                aria-label="Breadcrumb"
                class="flex items-center gap-1.5 font-mono text-xs text-stone-400 dark:text-stone-600"
            >
                <a
                    href="/blog/"
                    class="transition-colors hover:text-accent-600 dark:hover:text-accent-400"
                    >Writing</a
                >
                <span class="i-lucide-arrow-right size-3 shrink-0 opacity-50" aria-hidden="true"></span>
                <span class="truncate text-stone-600 dark:text-stone-400"
                    >{post.data.title}</span
                >
            </nav>

            <!-- Header -->
            <header class="mt-8 space-y-6 fade-in">
                <h1
                    class="font-serif text-4xl sm:text-5xl font-medium leading-[1.08] tracking-[-0.02em] text-stone-900 dark:text-stone-100 text-balance"
                >
                    {post.data.title}
                </h1>
                <p
                    class="text-lg leading-relaxed text-stone-600 dark:text-stone-400 text-pretty"
                >
                    {post.data.description}
                </p>

                <!-- Metadata + share -->
                <div
                    class="flex flex-wrap items-center justify-between gap-4 border-y hairline py-4"
                >
                    <div
                        class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs text-stone-500 dark:text-stone-500"
                    >
                        <time datetime={post.data.date.toISOString()}>
                            {
                                post.data.date.toLocaleDateString("en-US", {
                                    month: "long",
                                    day: "numeric",
                                    year: "numeric",
                                })
                            }
                        </time>
                        <span>
                            {readMinutes} min read
                        </span>
                        <span>
                            {wordCount.toLocaleString()} words
                        </span>
                    </div>
                    <ShareButton
                        client:load
                        body={body}
                        slug={slug}
                        title={post.data.title}
                        description={post.data.description}
                        tags={post.data.tags}
                    />
                </div>
            </header>

            <!-- Content -->
            <div class="prose-brand mt-10">
                <Content />
            </div>

            <!-- Author card -->
            <div class="mt-16 rounded-xl border hairline p-6 sm:p-8">
                <div
                    class="flex flex-col items-start gap-5 sm:flex-row sm:items-center"
                >
                    <Picture
                        src={avatarImage}
                        alt="Saku Shiina"
                        widths={[96, 128]}
                        quality={90}
                        sizes="96px"
                        class="size-14 shrink-0 overflow-hidden rounded-full ring-2 ring-accent-500/40"
                    />
                    <div class="flex-1">
                        <p
                            class="font-serif text-lg font-medium text-stone-900 dark:text-stone-100"
                        >
                            Saku Shiina
                            <span class="jp-accent ml-1.5" lang="ja">椎名 朔</span>
                        </p>
                        <p
                            class="mt-1 text-sm text-stone-600 dark:text-stone-400"
                        >
                            Independent web engineer. Writes about
                            architecture, performance, and interface craft.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Prev / Next nav -->
            {
                (olderPost || newerPost) && (
                    <nav
                        class="mt-12 grid gap-4 sm:grid-cols-2"
                        aria-label="Post navigation"
                    >
                        {olderPost ? (
                            <a
                                href={`/blog/${olderPost.id}/`}
                                class="group flex flex-col items-start gap-1.5 rounded-xl border hairline p-5 transition-colors hover:border-accent-400/50 dark:hover:border-accent-400/40"
                            >
                                <span class="kicker flex items-center gap-1.5">
                                    <span
                                        class="i-lucide-arrow-left size-3"
                                        aria-hidden="true"
                                    />
                                    Previous
                                </span>
                                <p class="font-serif text-base font-medium leading-snug text-stone-900 dark:text-stone-100 transition-colors group-hover:text-accent-600 dark:group-hover:text-accent-400">
                                    {olderPost.data.title}
                                </p>
                            </a>
                        ) : (
                            <div class="hidden sm:block" />
                        )}
                        {newerPost ? (
                            <a
                                href={`/blog/${newerPost.id}/`}
                                class="group flex flex-col items-start gap-1.5 rounded-xl border hairline p-5 transition-colors hover:border-accent-400/50 sm:items-end dark:hover:border-accent-400/40"
                            >
                                <span class="kicker flex items-center gap-1.5">
                                    Next
                                    <span
                                        class="i-lucide-arrow-right size-3"
                                        aria-hidden="true"
                                    />
                                </span>
                                <p class="text-right font-serif text-base font-medium leading-snug text-stone-900 dark:text-stone-100 transition-colors group-hover:text-accent-600 dark:group-hover:text-accent-400">
                                    {newerPost.data.title}
                                </p>
                            </a>
                        ) : (
                            <div class="hidden sm:block" />
                        )}
                    </nav>
                )
            }
        </div>
    </article>

    <div class="h-20"></div>

    <!-- TOC scroll-spy -->
    <script>const tocLinks = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
        if (tocLinks.length > 0) {
            const ACTIVE = ["text-accent-600", "dark:text-accent-400", "border-accent-500", "dark:border-accent-400"];
            const setActive = (slug: string) => {
                tocLinks.forEach((link) => {
                    const isActive = link.dataset.tocLink === slug;
                    link.classList.toggle("border-transparent", !isActive);
                    ACTIVE.forEach((c) => link.classList.toggle(c, isActive));
                });
            };
            const headingEls = [...tocLinks]
                .map((l) => document.getElementById(l.dataset.tocLink!))
                .filter((el): el is HTMLElement => el !== null);
            const spy = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) setActive(entry.target.id);
                    });
                },
                { rootMargin: "-20% 0px -70% 0px" },
            );
            headingEls.forEach((el) => spy.observe(el));
        }
    </script>
</BaseLayout>
