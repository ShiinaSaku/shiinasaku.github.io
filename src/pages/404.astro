---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | 404"
  description="The page you requested could not be found."
  noindex
>
  <div class="flex min-h-[calc(100svh-4rem)] w-full flex-col items-center justify-center px-4 text-center">
    <div class="fade-in flex flex-col items-center">
      <p class="kicker">404</p>
      <h1 class="title-hero mt-6">
        Like cherry blossoms,<br />
        <em class="italic text-accent-600 dark:text-accent-400">scattered</em>.
      </h1>
      <p
        class="jp-accent mt-6" lang="ja"
      >
        桜の花びらのように、お探しのページは風に運ばれてしまいました。
      </p>
      <a href="/" class="btn-primary mt-10">
        <span class="i-lucide-arrow-left size-4" aria-hidden="true"></span>
        戻る — Go back
      </a>
    </div>
  </div>
</BaseLayout>
