---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | 404"
  description="The page you requested could not be found."
  noindex
>
  <div class="relative flex min-h-[calc(100svh-4rem)] w-full flex-col items-center justify-center overflow-hidden px-4 text-center">

    <div class="sakura-container absolute inset-0 z-0 opacity-60 dark:opacity-40" aria-hidden="true">
      {Array.from({ length: 35 }).map((_, i) => {
        const duration = 5 + Math.random() * 7;
        const delay = Math.random() * -20;
        return (
          <span class="petal" style={`--i: ${i}; --duration: ${duration}s; --delay: ${delay}s;`}></span>
        )
      })}
    </div>

    <div class="relative z-10 flex flex-col items-center fade-in">
      <h1 class="font-display text-[8rem] sm:text-[12rem] lg:text-[16rem] font-bold leading-none tracking-tighter">
        <span class="gradient-text">404</span>
      </h1>

      <div class="relative z-10 -mt-4 flex flex-col items-center space-y-4 sm:-mt-8">
        <h2 class="font-display text-xl font-semibold tracking-tight text-zinc-900 dark:text-white sm:text-2xl">
          桜のように、散ってしまった。
        </h2>
        <p class="max-w-md text-sm font-light leading-relaxed text-zinc-600 dark:text-zinc-400 sm:text-base">
          Like cherry blossoms falling, the page you seek has drifted away on the wind.
        </p>
      </div>

      <a
        href="/"
        class="group mt-10 inline-flex items-center justify-center gap-2 rounded-full border border-zinc-200 bg-white/60 px-8 py-3.5 text-sm font-semibold text-zinc-900 backdrop-blur-md transition-all duration-200 hover:border-rose-400/50 hover:bg-rose-500/5 hover:text-rose-600 dark:border-white/15 dark:bg-white/5 dark:text-white dark:hover:border-rose-400/40 dark:hover:bg-rose-500/10 dark:hover:text-rose-400"
      >
        <span>戻る (Go back)</span>
        <span class="i-lucide-arrow-right size-4 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .sakura-container {
    perspective: 1000px;
  }

  .petal {
    position: absolute;
    top: -20%;
    width: 14px;
    height: 18px;
    background: linear-gradient(120deg, #fff1f6, #ffc9dd);
    border-radius: 0% 100% 100% 100% / 0% 100% 100% 100%;
    left: calc(var(--i) * 2.86%);
    animation: fall linear infinite;
    animation-duration: var(--duration);
    animation-delay: var(--delay);
    transform-origin: center bottom;
  }

  .petal:nth-child(even) {
    background: linear-gradient(120deg, #ffdce9, #ffc4db);
    width: 10px;
    height: 14px;
    border-radius: 50% 50% 50% 50% / 80% 80% 20% 20%;
  }

  @keyframes fall {
    0% {
      opacity: 0;
      top: -20%;
      transform: translateX(0px) rotateX(0deg) rotateY(0deg) rotateZ(0deg);
    }
    10% { opacity: 1; }
    80% { opacity: 1; }
    100% {
      opacity: 0;
      top: 120%;
      transform: translateX(120px) rotateX(720deg) rotateY(360deg) rotateZ(180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .petal {
      display: none;
      animation: none;
    }
  }
</style>
