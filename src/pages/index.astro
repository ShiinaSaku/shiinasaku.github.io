---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import avatar from "../assets/avatar.png";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const recentPosts = posts.slice(0, 4);

const tools = [
    { icon: "i-simple-icons-astro", name: "Astro" },
    { icon: "i-simple-icons-vuedotjs", name: "Vue" },
    { icon: "i-simple-icons-typescript", name: "TypeScript" },
    { icon: "i-simple-icons-rust", name: "Rust" },
    { icon: "i-simple-icons-go", name: "Go" },
    { icon: "i-simple-icons-nodedotjs", name: "Node.js" },
    { icon: "i-simple-icons-tailwindcss", name: "Tailwind CSS" },
    { icon: "i-simple-icons-bun", name: "Bun" },
];

function formatDate(date: Date): string {
    return date.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
    });
}
---

<BaseLayout
    title="Saku Shiina (椎名 朔) — Full-Stack Engineer"
    description="Saku Shiina (椎名 朔 / さくしいな) is a full-stack engineer building calm, fast web products with Astro, TypeScript, Rust, and Go. フルスタックエンジニア椎名朔のポートフォリオ・技術ブログ。"
    activePath="/"
    keywords="Saku Shiina, 椎名 朔, 椎名朔, さくしいな, Shiina Saku, full-stack engineer, フルスタックエンジニア, Astro developer, Rust, TypeScript"
>
    <script
        is:inline
        type="application/ld+json"
        set:html={`{"@context":"https://schema.org","@type":"ProfilePage","@id":"https://shiina.xyz/#profilepage","url":"https://shiina.xyz/","name":"Saku Shiina — Full-Stack Engineer","inLanguage":["en","ja"],"mainEntity":{"@id":"https://shiina.xyz/#person"}}`}
    />

    <section class="pt-16 pb-16 sm:pt-24 sm:pb-20">
        <div class="container-page">
            <div class="fade-in flex flex-col-reverse items-start gap-10 sm:flex-row sm:items-center sm:justify-between">
                <div class="max-w-2xl">
                    <p class="kicker">Full-Stack Engineer</p>
                    <h1 class="title-hero mt-7">
                        <span class="word-rise" style="animation-delay: 0ms">Software</span>
                        {" "}
                        <span class="word-rise" style="animation-delay: 90ms">should</span>
                        {" "}
                        <span class="word-rise" style="animation-delay: 180ms">feel</span>
                        {" "}
                        <span class="word-rise text-accent-600 dark:text-accent-400" style="animation-delay: 270ms">calm.</span>
                    </h1>
                    <p class="body-copy mt-7 max-w-xl text-lg">
                        I build fast, considered web products. I care about the
                        details most people never notice, because those are the
                        ones that make software feel right.
                    </p>
                    <p class="jp-accent mt-4 max-w-xl leading-loose" lang="ja">
                        フルスタックエンジニア。Astro・TypeScript・Rust・Go
                        を使い、速くて静かなウェブプロダクトを作っています。
                    </p>
                    <div class="mt-9 flex flex-wrap items-center gap-4">
                        <a href="/blog/" class="btn-primary">
                            Read the writing
                            <span class="i-lucide-arrow-right size-4" aria-hidden="true"></span>
                        </a>
                        <a href="mailto:sakushiina@proton.me" class="btn-secondary">
                            <span class="i-lucide-mail size-4" aria-hidden="true"></span>
                            Email
                        </a>
                    </div>
                </div>

                <div class="relative hidden shrink-0 sm:mr-4 sm:block">
                    <div
                        class="absolute -inset-4 rounded-xl bg-accent-500/15 blur-2xl"
                        aria-hidden="true"
                    >
                    </div>
                    <Image
                        src={avatar}
                        alt="Saku Shiina"
                        widths={[176, 352]}
                        sizes="176px"
                        quality={90}
                        class="squish relative size-44 rounded-full object-cover shadow-lg ring-4 ring-accent-500/40 dark:ring-accent-500/50"
                        loading="eager"
                        decoding="async"
                    />
                    <span
                        class="group absolute -bottom-2 -right-2 flex size-9 rotate-6 items-center justify-center rounded-lg bg-accent-500 shadow-md transition-transform duration-300 hover:rotate-12 hover:scale-110"
                        title="にゃ〜"
                        aria-hidden="true"
                    >
                        <span class="i-lucide-cat size-4.5 text-white"></span>
                    </span>
                </div>
            </div>
        </div>
    </section>

    <section class="border-t hairline py-16 sm:py-20">
        <div class="container-page">
            <div class="reveal flex items-end justify-between gap-6">
                <div>
                    <h2 class="title-display">Writing</h2>
                    <p class="jp-accent mt-1.5" lang="ja">設計と実装の記録。</p>
                </div>
                <a
                    href="/blog/"
                    class="link-wave inline-flex shrink-0 items-center gap-1.5 text-sm font-bold text-stone-500 transition-colors hover:text-accent-600 dark:text-stone-400 dark:hover:text-accent-400"
                >
                    All essays
                    <span class="i-lucide-arrow-right size-4" aria-hidden="true"></span>
                </a>
            </div>

            <div class="stagger mt-10 flex flex-col">
                {
                    recentPosts.map((post) => (
                        <a
                            href={`/blog/${post.id}/`}
                            class="group flex items-baseline gap-6 border-b hairline py-5 transition-colors first:border-t"
                        >
                            <time
                                datetime={post.data.date.toISOString()}
                                class="w-24 shrink-0 text-xs font-medium text-stone-400 dark:text-stone-600"
                            >
                                {formatDate(post.data.date)}
                            </time>
                            <span class="min-w-0 flex-1">
                                <span class="title-card block transition-colors group-hover:text-accent-600 dark:group-hover:text-accent-400">
                                    {post.data.title}
                                </span>
                                <span class="mt-1.5 block truncate text-sm text-stone-500 dark:text-stone-500">
                                    {post.data.description}
                                </span>
                            </span>
                            <span
                                class="i-lucide-arrow-up-right size-4 shrink-0 self-center text-stone-300 transition-all duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent-600 dark:text-stone-700 dark:group-hover:text-accent-400"
                                aria-hidden="true"
                            />
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="border-t hairline py-16 sm:py-20">
        <div class="container-page">
            <div class="reveal grid gap-10 md:grid-cols-[1fr_1.6fr]">
                <div>
                    <h2 class="title-display">About</h2>
                    <p class="jp-accent mt-1.5" lang="ja">私について。</p>
                </div>
                <div class="max-w-xl space-y-5">
                    <p class="body-copy">
                        I work across the stack — from interface craft in Vue
                        and TypeScript to systems in Rust and Go — but the
                        through-line is the same: reduce noise, keep intent,
                        ship things that hold up.
                    </p>
                    <p class="body-copy">
                        Off the clock I write about engineering here, tend to
                        a slowly growing list of
                        <a
                            href="/friends/"
                            class="link-wave font-bold text-accent-600 dark:text-accent-400"
                            >friends across the web</a
                        >, and collect watches I can't afford.
                    </p>
                    <ul class="flex flex-wrap items-center gap-4 pt-3" aria-label="Tools I use">
                        {
                            tools.map((tool) => (
                                <li class="flex items-center gap-1.5 text-stone-400 dark:text-stone-600" title={tool.name}>
                                    <span class={`${tool.icon} size-5`} aria-hidden="true" />
                                    <span class="sr-only">{tool.name}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
