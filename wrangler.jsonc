{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-24",
	"compatibility_flags": ["nodejs_compat"],
	"name": "saku_portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
